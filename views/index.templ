package views

import (
	db "tpe/db/sqlc"
)

templ IndexPage(productos []db.Producto, categorias []db.Categoria, categoriasMap map[int32]string) {
	@Layout("MarkeTandil - Gestión de Productos") {
		<div id="mensajes-feedback"></div>
		<div class="contenedor-principal">
			@EntityForm(categorias)
			@EntityList(productos, categoriasMap)
		</div>
	}
}
