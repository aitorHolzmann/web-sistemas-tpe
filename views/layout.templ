package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<!-- Pico.css: se enlaza localmente para funcionamiento offline y CDN según consigna -->
			<link rel="stylesheet" href="/static/pico.min.css"/>
			<!-- Estilos complementarios del proyecto servidos desde /static/ -->
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			<header class="encabezado">
				<h1>MarkeTandil</h1>
				<p>Panel de Gestión de Productos - Renderizado en Servidor con Templ (TP5)</p>
			</header>
			<main class="container" style="padding-top: 1.5rem; padding-bottom: 3rem;">
				{ children... }
			</main>
		</body>
	</html>
}
